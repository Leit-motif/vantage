<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything that needs Windows to be true: the overlay's own contract, read back from a real
    HWND, and the registry intent that travels through the Settings view model.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Vantage.Tests</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest" Version="3.10.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vantage.Core\Vantage.Core.csproj" />
    <ProjectReference Include="..\..\src\Vantage.Infrastructure\Vantage.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Vantage.App\Vantage.App.csproj" />
    <ProjectReference Include="..\Vantage.Tests.Support\Vantage.Tests.Support.csproj" />
  </ItemGroup>

</Project>
