<?xml version="1.0" encoding="utf-8"?>
<!--
  The other half of the suite: only the tests that send real keyboard input, and so need the
  dashboard to genuinely hold the Windows foreground. Run them deliberately, on a desktop nobody
  is using, and leave the machine alone while they run. The command is in the README, under
  "Build and run"; pass this file as the settings file.

  A settings file named on the command line replaces the project's default one, where these tests
  are excluded. A filter named on the command line would not: it is combined with the default
  filter rather than replacing it, and between them the two exclude everything.
-->
<RunSettings>
  <RunConfiguration>
    <TestCaseFilter>TestCategory=RequiresIdleDesktop</TestCaseFilter>
  </RunConfiguration>
</RunSettings>
