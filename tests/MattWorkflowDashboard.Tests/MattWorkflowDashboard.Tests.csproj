<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MattWorkflowDashboard.Tests</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!--
      Applied to every run of this project, however it is started — `dotnet test` on the project or
      on the solution, and the IDE's own runner. See the file for what it excludes and why.
    -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\MattWorkflowDashboard.Tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest" Version="3.10.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MattWorkflowDashboard.Core\MattWorkflowDashboard.Core.csproj" />
    <ProjectReference Include="..\..\src\MattWorkflowDashboard.Infrastructure\MattWorkflowDashboard.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MattWorkflowDashboard.App\MattWorkflowDashboard.App.csproj" />
  </ItemGroup>

</Project>
