# Build output
bin/
obj/
publish/
artifacts/
TestResults/

# IDE
*.user
.vs/

# Runtime instrumentation output. `--capture` and `--acceptance` write here; only the reviewed
# frames and records under docs/acceptance are committed, and they are put there deliberately.
captures/

# Application state. The dashboard writes these under %LOCALAPPDATA%, never into a repository,
# but a stray copy from a redirected run must not become a commit: cache.db can hold indexed
# content from monitored projects, and logs can hold their paths.
*.db
*.db-shm
*.db-wal
*.log
logs/

# Local secrets. Nothing in this project reads one today; the rule is here so that adding one
# later cannot quietly publish it.
.env
.env.*
!.env.example

# Local agent session state. Machine-local working material rather than evidence.
#
# `.scratch/` is deliberately NOT here: this project tracks its own specs and tickets as files
# under it, so they are evidence and belong in history like any other source. It is also the
# grammar this dashboard reads, which means Vantage can see its own project.
.agents/
.codex/
