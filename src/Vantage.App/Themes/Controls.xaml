<!--
  Compact native typography and Fluent outline icons. Colours are referenced dynamically so a
  theme swap or a Windows high-contrast change re-styles the running window without a restart.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <sys:Double x:Key="FontSizeCaption">11</sys:Double>
  <sys:Double x:Key="FontSizeBody">12.5</sys:Double>
  <sys:Double x:Key="FontSizeTitle">14</sys:Double>

  <Style TargetType="TextBlock" x:Key="BodyText">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style TargetType="TextBlock" x:Key="SecondaryText" BasedOn="{StaticResource BodyText}">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
  </Style>

  <Style TargetType="TextBlock" x:Key="TertiaryText" BasedOn="{StaticResource SecondaryText}">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>

  <Style TargetType="TextBlock" x:Key="TitleText" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style TargetType="TextBlock" x:Key="IconText">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A flat, quiet command button; the dashboard is for reading, not for clicking about. -->
  <Style TargetType="Button" x:Key="GlassButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource BorderStrongBrush}"
                  BorderThickness="1"
                  CornerRadius="5"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource StateInProgressBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToggleButton" x:Key="FilterChip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource BorderStrongBrush}"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource StateInProgressBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource StateInProgressBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox" x:Key="SearchBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Padding" Value="6,3" />
  </Style>

  <!--
    The bar the surface asks for. A Width setter alone never produced one: the stock ScrollBar
    template carries a MinWidth taken from SystemParameters.VerticalScrollBarWidth, and a minimum
    beats a width, so every ScrollViewer in the app arranged its bar at the system metric — 16.8
    here, at 125% — complete with the arrow buttons this surface has no use for. The Width property
    read 8 the whole time, which is why the setter looked like it was working.

    So the thickness lives in one place and the template is what makes it real.
  -->
  <sys:Double x:Key="ScrollBarThickness">8</sys:Double>

  <!-- The paging halves of the track: hit targets, and nothing to look at. -->
  <Style TargetType="RepeatButton" x:Key="ScrollPageButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Thumb" x:Key="ScrollThumb">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" Margin="1" CornerRadius="3"
                  Background="{DynamicResource TextTertiaryBrush}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="{StaticResource ScrollBarThickness}" />
    <Setter Property="MinWidth" Value="{StaticResource ScrollBarThickness}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}">
            <!--
              A reserved gutter is only worth having if it stays reserved, so the track is hidden
              rather than collapsed when there is nothing to scroll: the bar keeps its width and
              the content beside it keeps the same one at every content height.
            -->
            <Track x:Name="PART_Track"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb x:Name="Grip" Style="{StaticResource ScrollThumb}" MinHeight="24" />
              </Track.Thumb>
              <Track.DecreaseRepeatButton>
                <RepeatButton x:Name="PageBack" Style="{StaticResource ScrollPageButton}"
                              Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton x:Name="PageOn" Style="{StaticResource ScrollPageButton}"
                              Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Maximum" Value="0">
              <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden" />
            </Trigger>
            <!--
              A horizontal bar pages sideways. The commands are part of the swap and not merely
              the geometry: PageUp and PageDown move a vertical offset, so a horizontal track left
              bound to them looks right and does nothing when either half is clicked.
            -->
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
              <Setter TargetName="Grip" Property="MinHeight" Value="0" />
              <Setter TargetName="Grip" Property="MinWidth" Value="24" />
              <Setter TargetName="PageBack" Property="Command" Value="ScrollBar.PageLeftCommand" />
              <Setter TargetName="PageOn" Property="Command" Value="ScrollBar.PageRightCommand" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="{StaticResource ScrollBarThickness}" />
        <Setter Property="MinHeight" Value="{StaticResource ScrollBarThickness}" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
