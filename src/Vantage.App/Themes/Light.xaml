<!-- The same neutral palette, inverted, for owners who override Windows appearance. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="SurfaceColor">#F3F3F4</Color>
  <Color x:Key="SurfaceRaisedColor">#FFFFFF</Color>
  <Color x:Key="SurfaceOverlayColor">#FAFAFB</Color>
  <Color x:Key="BorderColor">#22000000</Color>
  <Color x:Key="BorderStrongColor">#D5D5D9</Color>

  <Color x:Key="TextPrimaryColor">#1A1A1D</Color>
  <Color x:Key="TextSecondaryColor">#5A5A62</Color>
  <Color x:Key="TextTertiaryColor">#84848C</Color>

  <Color x:Key="StateInProgressColor">#2C6BD6</Color>
  <Color x:Key="StateReadyColor">#0E8F80</Color>
  <Color x:Key="StateBlockedColor">#A9721A</Color>
  <Color x:Key="StateIdleColor">#6E6E77</Color>
  <Color x:Key="StateCompleteColor">#237D4C</Color>
  <Color x:Key="ConflictColor">#6D46C0</Color>
  <Color x:Key="ErrorColor">#C0392F</Color>

  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="{StaticResource SurfaceOverlayColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

  <SolidColorBrush x:Key="StateInProgressBrush" Color="{StaticResource StateInProgressColor}" />
  <SolidColorBrush x:Key="StateReadyBrush" Color="{StaticResource StateReadyColor}" />
  <SolidColorBrush x:Key="StateBlockedBrush" Color="{StaticResource StateBlockedColor}" />
  <SolidColorBrush x:Key="StateIdleBrush" Color="{StaticResource StateIdleColor}" />
  <SolidColorBrush x:Key="StateCompleteBrush" Color="{StaticResource StateCompleteColor}" />
  <SolidColorBrush x:Key="ConflictBrush" Color="{StaticResource ConflictColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

  <SolidColorBrush x:Key="TrackBrush" Color="#E3E3E6" />
  <SolidColorBrush x:Key="HoverBrush" Color="#EAEAEE" />

</ResourceDictionary>
