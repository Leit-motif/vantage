<!--
  Neutral charcoal-gray glass. Deliberately free of blue tint so the surface stays restrained
  over varied desktop content. Only the base surface is translucent; every content layer above
  it is opaque enough to stay legible on its own.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="SurfaceColor">#121213</Color>
  <Color x:Key="SurfaceRaisedColor">#1C1C1E</Color>
  <Color x:Key="SurfaceOverlayColor">#242426</Color>
  <Color x:Key="BorderColor">#33333733</Color>
  <Color x:Key="BorderStrongColor">#3A3A3D</Color>

  <Color x:Key="TextPrimaryColor">#EFEFF1</Color>
  <Color x:Key="TextSecondaryColor">#A8A8AE</Color>
  <Color x:Key="TextTertiaryColor">#75757D</Color>

  <Color x:Key="StateInProgressColor">#5B93F5</Color>
  <Color x:Key="StateReadyColor">#31C3B0</Color>
  <Color x:Key="StateBlockedColor">#E4A94F</Color>
  <Color x:Key="StateIdleColor">#8C8C95</Color>
  <Color x:Key="StateCompleteColor">#54B87C</Color>
  <Color x:Key="ConflictColor">#AE90EC</Color>
  <Color x:Key="ErrorColor">#E86F6F</Color>

  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="{StaticResource SurfaceOverlayColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

  <SolidColorBrush x:Key="StateInProgressBrush" Color="{StaticResource StateInProgressColor}" />
  <SolidColorBrush x:Key="StateReadyBrush" Color="{StaticResource StateReadyColor}" />
  <SolidColorBrush x:Key="StateBlockedBrush" Color="{StaticResource StateBlockedColor}" />
  <SolidColorBrush x:Key="StateIdleBrush" Color="{StaticResource StateIdleColor}" />
  <SolidColorBrush x:Key="StateCompleteBrush" Color="{StaticResource StateCompleteColor}" />
  <SolidColorBrush x:Key="ConflictBrush" Color="{StaticResource ConflictColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

  <SolidColorBrush x:Key="TrackBrush" Color="#2E2E31" />
  <SolidColorBrush x:Key="HoverBrush" Color="#2A2A2D" />

</ResourceDictionary>
