<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MattWorkflowDashboard.App</RootNamespace>
    <AssemblyName>MattWorkflowDashboard</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MattWorkflowDashboard.Core\MattWorkflowDashboard.Core.csproj" />
    <ProjectReference Include="..\MattWorkflowDashboard.Infrastructure\MattWorkflowDashboard.Infrastructure.csproj" />
  </ItemGroup>

</Project>
